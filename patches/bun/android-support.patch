+#ifdef __ANDROID__
+// Android's seccomp filter blocks close_range in app processes (Termux).
+// Fallback: iterate /proc/self/fd and close/cloexec each fd individually.
+static ssize_t bun_close_range_fallback(unsigned int start, unsigned int end, unsigned int flags)
+{
+    DIR* dir = opendir("/proc/self/fd");
+    if (!dir) {
+        unsigned int limit = end < 4096 ? end : 4096;
+        for (unsigned int fd = start; fd <= limit; fd++) {
+            if (flags & CLOSE_RANGE_CLOEXEC) {
+                fcntl(fd, F_SETFD, FD_CLOEXEC);
+            } else {
+                close(fd);
+            }
+        }
+        return 0;
+    }
+    int dir_fd = dirfd(dir);
+    struct dirent* entry;
+    while ((entry = readdir(dir)) != NULL) {
+        if (entry->d_name[0] < '0' || entry->d_name[0] > '9')
+            continue;
+        unsigned int fd = (unsigned int)atoi(entry->d_name);
+        if (fd < start || fd > end || (int)fd == dir_fd)
+            continue;
+        if (flags & CLOSE_RANGE_CLOEXEC) {
+            fcntl(fd, F_SETFD, FD_CLOEXEC);
+        } else {
+            close(fd);
+        }
+    }
+    closedir(dir);
+    return 0;
+}
+#endif
+
 // close_range is glibc > 2.33, which is very new
 extern "C" ssize_t bun_close_range(unsigned int start, unsigned int end, unsigned int flags)
 {
+#ifdef __ANDROID__
+    // Android seccomp blocks close_range syscall in app processes (e.g. Termux).
+    // Always use the fallback on Android.
+    return bun_close_range_fallback(start, end, flags);
+#else
     return syscall(__NR_close_range, start, end, flags);
+#endif
 }
 #else // OS(FREEBSD)
 // FreeBSD 12.2+ libc has close_range; 14.0+ supports CLOSE_RANGE_CLOEXEC
