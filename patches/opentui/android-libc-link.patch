+    // On Android, skip linkLibC (Zig cannot provide native libc) and
+    // instead link the NDK libc.so stub directly via addObjectFile.
+    // This ensures NEEDED libc.so in the output (required for dlopen).
+    const os_tag = target.result.os.tag;
+    const abi = target.result.abi;
+    if (os_tag == .linux and (abi == .android or abi == .androideabi)) {
+        const ndk_lib_dir = if (std.process.getEnvVarOwned(b.allocator, "ANDROID_NDK_LIB_DIR") catch null) |dir|
+            dir
+        else if (std.process.getEnvVarOwned(b.allocator, "ANDROID_NDK_HOME") catch null) |ndk_home|
+            std.fmt.allocPrint(b.allocator, "{s}/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/aarch64-linux-android/24", .{ndk_home}) catch unreachable
+        else
+            null;
+        if (ndk_lib_dir) |dir| {
+            const libc_path = std.fmt.allocPrint(b.allocator, "{s}/libc.so", .{dir}) catch unreachable;
+            lib.addObjectFile(.{ .cwd_relative = libc_path });
+            // dir = <NDK_TOOLCHAIN>/sysroot/usr/lib/<TRIPLE>/<API>
+            // We need: <NDK_TOOLCHAIN>/sysroot/usr/include for C headers
+            const ndk_include = std.fmt.allocPrint(b.allocator, "{s}/../../../include", .{dir}) catch unreachable;
+            lib.addSystemIncludePath(.{ .cwd_relative = ndk_include });
+        }
+    }
