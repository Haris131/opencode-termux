+fn addAndroidNdkPaths(b: *std.Build, artifact: *std.Build.Step.Compile) void {
+    const ndk_home = b.graph.env_map.get("ANDROID_NDK_HOME") orelse
+        @panic("ANDROID_NDK_HOME must be set for Android builds");
+    const ndk_tc = b.fmt("{s}/toolchains/llvm/prebuilt/linux-x86_64", .{ndk_home});
+    const ndk_sys = b.fmt("{s}/sysroot", .{ndk_tc});
+    const api = b.graph.env_map.get("ANDROID_API") orelse "29";
+    const ndk_lib = b.fmt("{s}/usr/lib/aarch64-linux-android/{s}", .{ndk_sys, api});
+    const clang_rt = b.fmt("{s}/lib/clang/19/lib/linux", .{ndk_tc});
+    artifact.addIncludePath(.{ .cwd_relative = b.fmt("{s}/usr/include/c++/v1", .{ndk_sys}) });
+    artifact.addSystemIncludePath(.{ .cwd_relative = b.fmt("{s}/usr/include", .{ndk_sys}) });
+    artifact.addSystemIncludePath(.{ .cwd_relative = b.fmt("{s}/usr/include/aarch64-linux-android", .{ndk_sys}) });
+    artifact.addLibraryPath(.{ .cwd_relative = ndk_lib });
+    // Add rpath to find libc++_shared.so at runtime on Termux
+    artifact.addRPath(.{ .cwd_relative = "/data/data/com.termux/files/usr/lib" });
+    artifact.addObjectFile(.{ .cwd_relative = b.fmt("{s}/crtbegin_so.o", .{ndk_lib}) });
+    artifact.addObjectFile(.{ .cwd_relative = b.fmt("{s}/crtend_so.o", .{ndk_lib}) });
+    artifact.addObjectFile(.{ .cwd_relative = b.fmt("{s}/libc.so", .{ndk_lib}) });
+    artifact.addObjectFile(.{ .cwd_relative = b.fmt("{s}/libm.so", .{ndk_lib}) });
+    artifact.linkSystemLibrary("c++_shared");
+    artifact.addObjectFile(.{ .cwd_relative = b.fmt("{s}/libclang_rt.builtins-aarch64-android.a", .{clang_rt}) });
+    artifact.addCSourceFile(.{ .file = b.path("android_shim.c"), .flags = &.{} });
+}
