+    // On Android, add NDK sysroot lib path so -lc finds libc.so.
+    // Zig 0.15 does not bundle Android libc, so we point it at the NDK.
+    // We use addLibraryPath (not addObjectFile) to avoid triggering Zig's
+    // internal libc provision which does not support Android.
+    const os_tag = target.result.os.tag;
+    const abi = target.result.abi;
+    if (os_tag == .linux and (abi == .android or abi == .androideabi)) {
+        if (std.process.getEnvVarOwned(b.allocator, "ANDROID_NDK_LIB_DIR") catch null) |dir| {
+            lib.addLibraryPath(.{ .cwd_relative = dir });
+        } else if (std.process.getEnvVarOwned(b.allocator, "ANDROID_NDK_HOME") catch null) |ndk_home| {
+            const dir = std.fmt.allocPrint(b.allocator, "{s}/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/aarch64-linux-android/24", .{ndk_home}) catch unreachable;
+            lib.addLibraryPath(.{ .cwd_relative = dir });
+        }
+    }
